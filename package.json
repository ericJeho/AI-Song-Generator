{
  "name": "cadence-song-generator",
  "version": "2.0.0",
  "private": true,
  "description": "Turn a text prompt into a song, with genre, mood, instrument, lyrics, tempo and length controls. Supabase backend, Appwrite Sites front end.",
  "scripts": {
    "test": "deno test --allow-net --allow-env --allow-read --node-modules-dir=none supabase/functions/api && node --test test/synth.test.mjs",
    "check": "deno check --node-modules-dir=none supabase/functions/api/index.ts",
    "serve": "deno run --allow-net --allow-read jsr:@std/http@1/file-server public",
    "test:synth": "node --test test/synth.test.mjs"
  },
  "devDependencies": {
    "deno": "2.9.6",
    "playwright": "1.56.1"
  }
}
