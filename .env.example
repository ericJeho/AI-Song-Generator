# Copy this file to .env and fill in your key. Never commit .env.

# ElevenLabs API key (needs a plan that includes music generation).
# Leave empty to run in demo mode with silent placeholder songs.
ELEVENLABS_API_KEY=

# Optional settings
# PORT=8000
# VERSIONS_PER_REQUEST=2      # songs per click; each one is a separate paid API call
# RATE_LIMIT_PER_HOUR=20      # generate requests allowed per visitor IP per hour
# AUDIO_DIR=./generated       # where finished MP3s are saved
# ELEVENLABS_MUSIC_MODEL=music_v1
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
