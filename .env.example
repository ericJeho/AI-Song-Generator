# Copy this file to .env and fill in what you use. Never commit .env.

# ---------- Music (one is enough) ----------
# ElevenLabs Music: a plan that includes music generation.
ELEVENLABS_API_KEY=
# MiniMax Music: an account at platform.minimax.io.
MINIMAX_API_KEY=
# Which one to use when both keys are set: elevenlabs | minimax | mock.
# Empty = ElevenLabs if its key is set, else MiniMax, else demo mode (silent songs).
# MUSIC_PROVIDER=
# MINIMAX_MUSIC_MODEL=music-2.6

# ---------- Lyrics helper (optional) ----------
# Claude API key from console.anthropic.com. Turns on "Draft from my description".
ANTHROPIC_API_KEY=

# ---------- Accounts ----------
# Visitors must sign in to generate (true/false).
REQUIRE_LOGIN=true
# Invite code new accounts must enter. Strongly recommended: without it anyone can sign up.
SIGNUP_CODE=
# Per-account daily limits.
DAILY_SONGS_PER_USER=10
DAILY_LYRICS_PER_USER=20

# ---------- Other settings ----------
# PORT=8000
# DATA_DIR=./data              # accounts and generated songs live here
# SESSION_SECRET=              # optional; otherwise a random one is saved in DATA_DIR
# VERSIONS_PER_REQUEST=2       # songs per click; each is a separate paid API call
# RATE_LIMIT_PER_HOUR=20       # generate requests per visitor IP per hour
